KRS_LOGIN_SSO_URL=""
KRS_DASHBOARD_URL=""
KRS_GET_SCHEDULES="" # Get
KRS_GET_SCHEDULE_DETAIL=""  # Post, with {id as schedule_id}
KRS_SCHEDULES_FORM="" # Get
KRS_POST_SCHEDULES="" # Post

# Cloudflare Turnstile — optional; leave both empty to disable the challenge
NEXT_PUBLIC_TURNSTILE_SITE_KEY="" # Public site key (0x...), rendered in the browser
TURNSTILE_SECRET_KEY="" # Secret key, used server-side for siteverify

# Analytics (PostHog) — optional; leave empty to disable tracking
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="" # PostHog project token (phc_...)
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# "Generate Schedule with AI" — optional; leave AI_API_KEY empty to disable the feature.
# Works with any OpenAI-compatible chat completions endpoint (OpenAI, Groq, OpenRouter, etc).
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

PORT=
