# Test War Mode — simulate the KRS war instead of hitting the real university
# server. Set both together for local dev/testing; never enable in production.
WAR_TEST_MODE="false"
NEXT_PUBLIC_WAR_TEST_MODE="false"
# Optional: deterministic PRNG seed for reproducible simulated war runs.
WAR_TEST_SEED=
# Optional: override the default outcome split (JSON, keys must sum to ~1).
# Default: {"success":0.65,"class_full":0.15,"time_conflict":0.1,"server_busy":0.05,"network_timeout":0.05}
WAR_TEST_PROBABILITIES=

# Cloudflare Turnstile, for challange on load website
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics (PostHog), for analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Logs every captured event (name, distinct id, properties, timestamp) to the
NEXT_PUBLIC_ANALYTICS_DEBUG="false"

# Only work with OpenAI Compatible provider. For generate schedule based with AI
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

PORT=

# Shlink (internal short-link service), for Share Schedule feature
SHLINK_BASE_URL=""
SHLINK_API_KEY=

# Public origin of this app — used to build/validate Share Schedule links
APP_URL=""
